{
    "##": "DRAFT Scoop manifest for venvctl. Replace every <...> placeholder; hashes come from dist\\SHA256SUMS.",
    "version": "<0.1.0>",
    "description": "Control your Python virtual environments on Windows: activate, find, prune, unlock, repair, diagnose.",
    "homepage": "<https://github.com/OWNER/venvctl>",
    "license": "<MIT>",
    "architecture": {
        "64bit": {
            "url": "<https://github.com/OWNER/venvctl/releases/download/v0.1.0/venvctl-0.1.0-windows-amd64.zip>",
            "hash": "<SHA256 OF venvctl-0.1.0-windows-amd64.zip>"
        },
        "arm64": {
            "url": "<https://github.com/OWNER/venvctl/releases/download/v0.1.0/venvctl-0.1.0-windows-arm64.zip>",
            "hash": "<SHA256 OF venvctl-0.1.0-windows-arm64.zip>"
        }
    },
    "bin": "venvctl.exe",
    "notes": [
        "Run 'venvctl init' once, then open a new terminal.",
        "Shell hooks record this exe's path; after 'scoop update' moves it, run 'venvctl init' again (venvctl doctor flags a stale hook)."
    ],
    "checkver": {
        "github": "<https://github.com/OWNER/venvctl>"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "<https://github.com/OWNER/venvctl>/releases/download/v$version/venvctl-$version-windows-amd64.zip"
            },
            "arm64": {
                "url": "<https://github.com/OWNER/venvctl>/releases/download/v$version/venvctl-$version-windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
