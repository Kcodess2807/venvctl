{
    "##": "Scoop manifest template for venvctl. The release workflow fills @VERSION@, @SHA_AMD64@ and @SHA_ARM64@ from dist\\SHA256SUMS.",
    "version": "@VERSION@",
    "description": "Control your Python virtual environments on Windows: activate, find, prune, unlock, repair, diagnose.",
    "homepage": "https://github.com/Kcodess2807/venvctl",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Kcodess2807/venvctl/releases/download/v@VERSION@/venvctl-@VERSION@-windows-amd64.zip",
            "hash": "@SHA_AMD64@"
        },
        "arm64": {
            "url": "https://github.com/Kcodess2807/venvctl/releases/download/v@VERSION@/venvctl-@VERSION@-windows-arm64.zip",
            "hash": "@SHA_ARM64@"
        }
    },
    "bin": "venvctl.exe",
    "notes": [
        "Run 'venvctl init' once, then open a new terminal.",
        "Shell hooks record this exe's path; after 'scoop update' moves it, run 'venvctl init' again (venvctl doctor flags a stale hook)."
    ],
    "checkver": {
        "github": "https://github.com/Kcodess2807/venvctl"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kcodess2807/venvctl/releases/download/v$version/venvctl-$version-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/Kcodess2807/venvctl/releases/download/v$version/venvctl-$version-windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
